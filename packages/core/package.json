{
  "name": "@nabi/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types src/**/*.test.ts",
    "seed": "tsx --env-file-if-exists=../../apps/web/.env.local scripts/seed.ts",
    "test-token": "tsx --env-file-if-exists=../../apps/web/.env.local scripts/test-token.ts",
    "check-recording": "tsx --env-file-if-exists=../../apps/web/.env.local scripts/check-recording.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1167.0",
    "@aws-sdk/s3-request-presigner": "^3.1167.0",
    "@nabi/shared": "workspace:*",
    "firebase-admin": "^13.3.0",
    "livekit-server-sdk": "^2.19.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.20.0",
    "typescript": "^5"
  }
}
