{
  "name": "nabi",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "engines": { "node": ">=22.14.0" },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-nabi",
    "livekit": "livekit-server --dev --bind 0.0.0.0 --config livekit.dev.yaml",
    "seed": "pnpm --filter @nabi/core seed",
    "test-token": "pnpm --filter @nabi/core test-token"
  },
  "devDependencies": {
    "firebase-tools": "^15.0.0"
  }
}
