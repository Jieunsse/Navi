# 브라우저용 Firebase 설정(배포 때 실제 값으로 바꾼다)
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-nabi.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-nabi
NEXT_PUBLIC_USE_EMULATORS=true

# 서버용 Firebase 관리자 키. 에뮬레이터를 쓰면 비워 둔다.
FIREBASE_PROJECT_ID=demo-nabi
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# LiveKit. 로컬은 `pnpm livekit` 개발 서버 기본값이다.
LIVEKIT_URL=ws://localhost:7880
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# 테스트 계정 버튼 로그인(4-18). 심사가 끝나면 false로 바꾼다.
ENABLE_TEST_LOGIN=true

# 토스페이먼츠 테스트 키(공식 샘플 저장소 tosspayments/tosspayments-sample의 공개 키). 테스트 결제라 실제 돈이 나가지 않는다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_D5GePWvyJnrK0W0k6q8gLzN97Eoq
TOSS_SECRET_KEY=test_sk_zXLkKEypNArWmo50nX3lmeaxYG5R

# 녹화 저장소(S3 호환 API). 배포는 Cloudflare R2, 로컬은 docker-compose.dev.yml의 s3mock이다(4-9).
# R2: STORAGE_ENDPOINT=https://<계정ID>.r2.cloudflarestorage.com, STORAGE_REGION=auto, 키는 R2 API 토큰
STORAGE_ENDPOINT=http://localhost:9090
# LiveKit egress(도커 안)가 저장소를 부르는 주소. 로컬만 다르다. 배포(R2)는 비워 두면 STORAGE_ENDPOINT를 쓴다.
STORAGE_EGRESS_ENDPOINT=http://storage:9090
STORAGE_REGION=us-east-1
STORAGE_BUCKET=nabi-recordings
STORAGE_ACCESS_KEY_ID=nabi-dev
STORAGE_SECRET_ACCESS_KEY=nabi-dev-secret

# 정산(4-12). 송금은 목업(mock)만 있다. 실제 송금은 나중에 결제대행사 지급대행으로 만든다.
PAYOUT_MODE=mock
# 운영자 화면의 "월 정산 지금 실행(테스트)" 버튼. 심사가 끝나면 false로 바꾼다.
ENABLE_SETTLEMENT_TEST=true
# 월 정산 예약 작업 입구(/api/jobs/monthly-settlement)의 비밀 값. 비어 있으면 입구가 닫힌다.
CRON_SECRET=
